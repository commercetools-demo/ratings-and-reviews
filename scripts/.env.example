# Credentials for scripts/seed-review-states.mjs.
# Copy to ../.env.local (repository root, gitignored) and fill in:
#   cp scripts/.env.example .env.local
# Use a dedicated API client; manage_states, view_states and view_project_settings are enough
# (reviews: manage_products, view_products, view_states).
CTP_PROJECT_KEY="your-project-key"
CTP_CLIENT_ID=""
CTP_CLIENT_SECRET=""
# Region hosts (gcp-eu shown; gcp-us: us-central1.gcp, aws-eu: eu-central-1.aws, aws-us: us-east-2.aws)
CTP_AUTH_URL="https://auth.europe-west1.gcp.commercetools.com"
CTP_API_URL="https://api.europe-west1.gcp.commercetools.com"
CTP_SCOPES="manage_states:your-project-key view_states:your-project-key view_project_settings:your-project-key"
