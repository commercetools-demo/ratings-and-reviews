# Copy to mc-reviews-and-ratings-app/.env.local (gitignored, wins over .env) and fill in.
# Project the dev server opens, and the Merchant Center cloud:
INITIAL_PROJECT_KEY="your-project-key"
CLOUD_IDENTIFIER="gcp-eu"   # gcp-us | gcp-eu | aws-us | aws-eu
# Only needed for production builds (Connect / Netlify):
# CUSTOM_APPLICATION_ID=""
# APPLICATION_URL="https://your-host"

# The seed script has its own example: scripts/.env.example
